# Puerto del servidor
PORT=3000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/almacen_erp?schema=public"

# Configuracion JWT
JWT_SECRET="super-secret-key-cambiar-en-produccion"
JWT_REFRESH_SECRET="super-refresh-key-cambiar-en-produccion"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Almacenamiento local de archivos
UPLOAD_DIR="./uploads"
