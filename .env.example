# Puerto del servidor
PORT=3000

# Configuracion CORS (Cross-Origin Resource Sharing)
# CORS_ENABLED: true para activar, false para desactivar
CORS_ENABLED=true
# CORS_ORIGIN: Lista de dominios permitidos separados por comas, o * para permitir cualquier origen
CORS_ORIGIN="http://localhost:4200,http://localhost:3000"

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/almacen_erp?schema=public"

# Configuracion JWT
JWT_SECRET="super-secret-key-cambiar-en-produccion"
JWT_REFRESH_SECRET="super-refresh-key-cambiar-en-produccion"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Almacenamiento local de archivos
UPLOAD_DIR="./uploads"
